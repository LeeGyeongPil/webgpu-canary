# No API keys are needed. These optional variables only change how the CLI and examples behave.

# Message language for the CLI and examples: en or ko (the --lang flag wins over this)
WEBGPU_CANARY_LANG=en

# Set to 1 to run the real-model test and example (downloads about 100 MB from the Hugging Face Hub)
WEBGPU_CANARY_REAL=

# Set to 1 behind an HTTP(S) proxy so Node's built-in fetch uses HTTP_PROXY / HTTPS_PROXY
NODE_USE_ENV_PROXY=
